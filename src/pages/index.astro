---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Astro">
	<h1>Astro</h1>
	<p class="lede">Markdown documentation, routed straight from the filesystem.</p>
	<a class="cta" href="/docs">Browse the docs →</a>
</Layout>

<style>
	h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3rem);
		letter-spacing: -0.02em;
	}

	.lede {
		margin: 0.75rem 0 1.75rem;
		color: var(--muted);
		font-size: 1.125rem;
	}

	.cta {
		display: inline-block;
		padding: 0.55rem 1.1rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-fg);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}

	.cta:hover {
		opacity: 0.88;
	}
</style>
