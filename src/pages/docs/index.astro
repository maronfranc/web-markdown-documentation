---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { docDescription, docTitle, groupDocs } from '../../lib/docs';

const sorted = (await getCollection('docs')).sort((a, b) => {
	const order = (a.data.order ?? Number.MAX_SAFE_INTEGER) - (b.data.order ?? Number.MAX_SAFE_INTEGER);
	return order !== 0 ? order : docTitle(a).localeCompare(docTitle(b));
});

const groups = groupDocs(sorted);
---

<Layout title="Documentation">
	<h1>Documentation</h1>
	{
		groups.map((group) => (
			<section class="doc-group">
				<h2 class="doc-group__title">{group.label}</h2>
				<ul class="doc-list">
					{group.docs.map((doc) => (
						<li>
							<a href={`/docs/${doc.id}`}>{docTitle(doc)}</a>
							{docDescription(doc) && <p>{docDescription(doc)}</p>}
						</li>
					))}
				</ul>
			</section>
		))
	}
</Layout>

<style>
	h1 {
		margin: 0 0 1.5rem;
		font-size: clamp(2rem, 6vw, 3rem);
		letter-spacing: -0.02em;
	}

	.doc-group + .doc-group {
		margin-top: 2.5rem;
	}

	.doc-group__title {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.doc-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.doc-list li {
		padding: 1rem 1.25rem;
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		background: var(--surface);
	}

	.doc-list a {
		color: var(--fg);
		font-size: 1.0625rem;
		font-weight: 600;
		text-decoration: none;
	}

	.doc-list a:hover {
		text-decoration: underline;
	}

	.doc-list p {
		margin: 0.25rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
</style>
